<Window x:Class="GLLRV.DesktopApp.Views.FirstAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Primeiro Acesso"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f2f4f8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Primeiro acesso"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,4"/>

        <TextBlock Text="Defina uma nova senha e uma frase de segurança."
                   Margin="0,24,0,0"
                   Foreground="#555"/>

        <StackPanel Grid.Row="1" Margin="0,40,0,0">
            <TextBlock Text="Nova senha" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Height="28"/>

            <TextBlock Text="Repita a nova senha" Margin="0,12,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="28"/>

            <TextBlock Text="Frase de segurança" Margin="0,12,0,4"/>
            <TextBox x:Name="SecurityPhraseTextBox" Height="28"/>
        </StackPanel>

        <Button Grid.Row="2"
                Content="CONFIRMAR"
                Width="160"
                Height="36"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Click="ConfirmButton_Click"
                Background="#111827"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"/>
    </Grid>
</Window>
