<Window x:Class="GLLRV.DesktopApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GLLRV - Suporte"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <!-- Fundo com a imagem -->
    <Window.Resources>
        <ImageBrush x:Key="WindowBackgroundBrush"
                    ImageSource="/Assets/gllrv-bg.png"
                    Stretch="UniformToFill"
                    Opacity="0.14"/>
    </Window.Resources>
    <Window.Background>
        <StaticResource ResourceKey="WindowBackgroundBrush"/>
    </Window.Background>

    <!-- Layout geral: coluna esquerda (menu) + coluna direita (conteúdo) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>   <!-- cabeçalho -->
            <RowDefinition Height="*"/>    <!-- conteúdo -->
        </Grid.RowDefinitions>

        <!-- MENU LATERAL ESQUERDO -->
        <Border Grid.RowSpan="2" Grid.Column="0" Background="#111827">
            <StackPanel Margin="16">
                <!-- cartão do usuário -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                    <Ellipse Width="56" Height="56" Fill="#FF8A00"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock x:Name="NomeUsuarioTextBlock" FontWeight="Bold" FontSize="16" Text="Usuário" />
                        <TextBlock x:Name="UserLevelText" Text="Técnico - Nível 1" Foreground="#BFD1FF" FontSize="12"/>
                        <TextBlock x:Name="UserCategoryText" Text="Categoria" Foreground="#BFD1FF" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- botões de navegação (mesmos handlers do seu code-behind) -->
                <Button Content="Usuários"              Height="40" Margin="0,0,0,12" Click="UsuariosButton_Click"/>
                <Button Content="Relatórios"            Height="40" Margin="0,0,0,12" Click="RelatoriosButton_Click"/>
                <Button Content="Chamados Pendentes"    Height="40" Margin="0,0,0,12" Click="ChamadosPendentesButton_Click"/>
                <Button Content="Histórico de Chamados" Height="40" Margin="0,0,0,12" Click="HistoricoChamadosButton_Click"/>
                <Button Content="Chamados em Andamento" Height="40" Margin="0,0,0,12" Click="ChamadosAndamentoButton_Click"/>
                <Button Content="Configurações"         Height="40" Margin="0,0,0,12" Click="ConfiguracaoButton_Click"/>
            </StackPanel>
        </Border>

        <!-- CABEÇALHO (direita) -->
        <Grid Grid.Column="1" Grid.Row="0" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- título: pega o Tag da Page carregada -->
            <TextBlock Text="{Binding ElementName=MainContentFrame, Path=Content.Tag}"
                       FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>

            <!-- relógio (seu code-behind pode atualizar ClockText) -->
            <TextBlock x:Name="ClockText"
                       Grid.Column="1"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Foreground="#333"/>

            <!-- sair -->
            <Button Grid.Column="2"
                    Content="SAIR"
                    Padding="24,8"
                    Click="SairButton_Click"/>
        </Grid>

        <!-- CONTEÚDO (direita) -->
        <Border Grid.Column="1" Grid.Row="1" Margin="16" CornerRadius="18" Background="#80FFFFFF">
            <Frame x:Name="MainContentFrame"
                   Background="Transparent"
                   NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>
