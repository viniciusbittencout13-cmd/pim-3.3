<Window x:Class="GLLRV.DesktopApp.Views.MainWindow"
<Window x:Class="GLLRV.DesktopApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:GLLRV.DesktopApp.Views.Pages"
        Title="GLLRV - Suporte"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <ImageBrush x:Key="WindowBackgroundBrush"
                    ImageSource="pack://application:,,,/GLLRV.DesktopApp;component/Assets/gllrv-bg.png"
                    Stretch="UniformToFill"
                    Opacity="0.35" />
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- MENU LATERAL ESQUERDO -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="2"
                Background="#111827">
            <StackPanel Margin="16">

                <!-- BLOCO DO TÉCNICO -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,32">
                    <Border Width="56" Height="56"
                            CornerRadius="28"
                            Background="#F97316"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding NomeInicial, Mode=OneWay}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText"
                                   Text="Usuário"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="14"/>
                        <TextBlock x:Name="UserLevelText"
                                   Text="Técnico - Nível 1"
                                   Foreground="#9CA3AF"
                                   FontSize="12"/>
                        <TextBlock x:Name="UserCategoryText"
                                   Text="Categoria"
                                   Foreground="#9CA3AF"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- BOTÕES DO MENU -->
                <Button Content="Usuários"
                        Margin="0,0,0,8"
                        Height="40"
                        Click="UsuariosButton_Click"/>
                <Button Content="Relatórios"
                        Margin="0,0,0,8"
                        Height="40"
                        Click="RelatoriosButton_Click"/>
                <Button Content="Chamados Pendentes"
                        Margin="0,0,0,8"
                        Height="40"
                        Click="ChamadosPendentesButton_Click"/>
                <Button Content="Histórico de Chamados"
                        Margin="0,0,0,8"
                        Height="40"
                        Click="HistoricoChamadosButton_Click"/>
                <Button Content="Chamados em Andamento"
                        Margin="0,0,0,8"
                        Height="40"
                        Click="ChamadosAndamentoButton_Click"/>
                <Button Content="Configurações"
                        Margin="0,16,0,0"
                        Height="40"
                        Click="ConfiguracaoButton_Click"/>

            </StackPanel>
        </Border>

        <!-- TOPO -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="16,16,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="CHAMADOS PENDENTES"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock x:Name="DateTimeText"
                           VerticalAlignment="Center"
                           Foreground="#111827"
                           FontWeight="SemiBold"/>
                <Button Content="SAIR"
                        Width="120"
                        Height="40"
                        Margin="0,0,0,0"
                        Click="SairButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- CONTEÚDO (PÁGINAS) -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="16,8,16,16"
                CornerRadius="24"
                Background="#F9FAFB"
                Opacity="0.92">
            <Frame x:Name="ContentFrame"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent" />
        </Border>

    </Grid>
</Window>
