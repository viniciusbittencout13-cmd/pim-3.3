<Page x:Class="GLLRV.DesktopApp.Views.Pages.ChamadosAndamentoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      d:DesignHeight="400"
      d:DesignWidth="800"
      Title="Chamados Andamento"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    <Grid>
        <DataGrid x:Name="ChamadosGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                <DataGridTextColumn Header="Responsável" Binding="{Binding Responsavel}" Width="160"/>
                <DataGridTextColumn Header="Abertura" Binding="{Binding DataAbertura}" Width="160"
                                     BindingStringFormat="dd/MM/yyyy HH:mm"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
