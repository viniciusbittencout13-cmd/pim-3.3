<Page x:Class="GLLRV.DesktopApp.Views.Pages.ChamadosPendentesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="720"
      d:DesignWidth="1024"
      Background="Transparent">

    <Grid>

        <!-- Cabeçalho -->
        <Border Background="#F0F0F0"
                CornerRadius="20"
                Margin="260,40,40,0"
                Height="60"
                VerticalAlignment="Top">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="CHAMADOS PENDENTES"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#222"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DataAtualText"
                               Margin="0,0,20,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#444"/>
                    <Button Content="SAIR"
                            Width="120"
                            Height="40"
                            FontSize="16"
                            Background="#E0E0E0"
                            Foreground="#222"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid central -->
        <Border Margin="260,120,40,40"
                Background="#CCFFFFFF"
                CornerRadius="20">
            <DataGrid x:Name="ChamadosDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      Margin="10">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="USUÁRIO"
                                        Binding="{Binding Usuario}"
                                        Width="*"/>
                    <DataGridTextColumn Header="NÍVEL DE PRIORIDADE"
                                        Binding="{Binding NivelPrioridade}"
                                        Width="*"/>
                    <DataGridTextColumn Header="DIFICULDADE"
                                        Binding="{Binding Dificuldade}"
                                        Width="*"/>
                    <DataGridTextColumn Header="DATA"
                                        Binding="{Binding DataAbertura}"
                                        Width="*"/>
                    <DataGridTextColumn Header="HORÁRIO"
                                        Binding="{Binding Horario}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Menu lateral (placeholder simples) -->
        <Border Grid.RowSpan="2"
                Background="#111827"
                Width="260"
                Margin="0"
                HorizontalAlignment="Left">
            <StackPanel Margin="20,40,20,20">
                <TextBlock Text="MENU"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="USUÁRIOS" Margin="0,0,0,10" Height="40"/>
                <Button Content="RELATÓRIOS" Margin="0,0,0,10" Height="40"/>
                <Button Content="CHAMADOS PENDENTES" Margin="0,0,0,10" Height="40"/>
                <Button Content="HISTÓRICO CHAMADOS" Margin="0,0,0,10" Height="40"/>
                <Button Content="CHAMADOS ANDAMENTO" Margin="0,0,0,10" Height="40"/>
                <Button Content="CONFIGURAÇÃO" Margin="0,0,0,10" Height="40"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
