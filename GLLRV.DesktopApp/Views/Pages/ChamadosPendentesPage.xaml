<UserControl x:Class="GLLRV.DesktopApp.Views.Pages.ChamadosPendentesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- Cabeçalho / filtros -->
            <RowDefinition Height="Auto"/>
            <!-- Lista -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,16">
            <TextBlock Text="Chamados pendentes"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="Visualize e gerencie todos os chamados que ainda aguardam atendimento."
                       Margin="0,4,0,0"
                       Foreground="#6B7280"
                       FontSize="12"/>

            <!-- Linha de filtros -->
            <StackPanel Orientation="Horizontal"
            Margin="0,16,0,0"
            VerticalAlignment="Center">
    <!-- Busca -->
    <Border Background="#F3F4F6"
            CornerRadius="6"
            Padding="8"
            Width="260">
        <DockPanel>
            <TextBlock Text="🔍"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox"
         BorderThickness="0"
         Background="Transparent"
         VerticalAlignment="Center"
         FontSize="12"
         TextChanged="SearchBox_TextChanged"
         ToolTip="Buscar por número, cliente ou assunto..."/>
        </DockPanel>
    </Border>

    <!-- Prioridade -->
    <ComboBox x:Name="PrioridadeFilter"
              Width="140"
              Margin="8,0,0,0"
              Padding="4"
              FontSize="12"
              SelectionChanged="Filtro_Changed">
        <ComboBoxItem Content="Todas prioridades" IsSelected="True"/>
        <ComboBoxItem Content="Crítica"/>
        <ComboBoxItem Content="Alta"/>
        <ComboBoxItem Content="Média"/>
        <ComboBoxItem Content="Baixa"/>
    </ComboBox>

    <!-- SLA -->
    <ComboBox x:Name="SlaFilter"
              Width="160"
              Margin="8,0,0,0"
              Padding="4"
              FontSize="12"
              SelectionChanged="Filtro_Changed">
        <ComboBoxItem Content="Todos SLAs" IsSelected="True"/>
        <ComboBoxItem Content="Vencidos"/>
        <ComboBoxItem Content="Vencendo hoje"/>
        <ComboBoxItem Content="Dentro do prazo"/>
    </ComboBox>
</StackPanel>

        <!-- GRADE DE CHAMADOS -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                CornerRadius="10"
                Padding="10"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <DataGrid x:Name="ChamadosGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="34"
                      FontSize="12"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      BorderThickness="0"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº" Binding="{Binding Numero}" Width="80"/>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                    <DataGridTextColumn Header="Assunto" Binding="{Binding Assunto}" Width="2*"/>
                    <DataGridTextColumn Header="Prioridade" Binding="{Binding Prioridade}" Width="100"/>
                    <DataGridTextColumn Header="Abertura" Binding="{Binding DataAbertura}" Width="140"/>
                    <DataGridTextColumn Header="SLA" Binding="{Binding SLA}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
