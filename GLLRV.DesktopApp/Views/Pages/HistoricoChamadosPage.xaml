<UserControl x:Class="GLLRV.DesktopApp.Views.Pages.HistoricoChamadosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Tag="HISTÓRICO DE CHAMADOS">
    <Grid Margin="16">
        <Border Background="#F7F9FC" CornerRadius="16" Padding="16">
            <DataGrid x:Name="ChamadosGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="TÍTULO" Binding="{Binding Titulo}" Width="2*" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*" />
                    <DataGridTextColumn Header="RESPONSÁVEL" Binding="{Binding Responsavel}" Width="*" />
                    <DataGridTextColumn Header="ABERTURA" Binding="{Binding Abertura}" Width="*" />
                    <DataGridTextColumn Header="FECHAMENTO" Binding="{Binding Fechamento}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
