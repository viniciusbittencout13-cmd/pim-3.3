<UserControl x:Class="GLLRV.DesktopApp.Views.Pages.HistoricoChamadosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A página ocupa toda a área do ContentPresenter no MainWindow -->
    <Grid Margin="0">
        <DataGrid x:Name="HistoricoGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  Margin="0"
                  ColumnHeaderHeight="28"
                  RowHeight="28">

            <DataGrid.Columns>
                <DataGridTextColumn Header="USUÁRIO" Binding="{Binding Usuario}" Width="*" />
                <DataGridTextColumn Header="NÍVEL DE PRIORIDADE" Binding="{Binding NivelPrioridade}" Width="160"/>
                <DataGridTextColumn Header="DIFICULDADE" Binding="{Binding Dificuldade}" Width="120"/>
                <DataGridTextColumn Header="DATA INÍCIO" Binding="{Binding DataInicio, StringFormat=\{0:dd/MM/yyyy\}}" Width="120"/>
                <DataGridTextColumn Header="DATA TÉRMINO" Binding="{Binding DataTermino, StringFormat=\{0:dd/MM/yyyy\}}" Width="130"/>
                <DataGridTextColumn Header="HORÁRIO INÍCIO" Binding="{Binding HorarioInicio, StringFormat=\{0:hh\\:mm\}}" Width="120"/>
                <DataGridTextColumn Header="HORÁRIO TÉRMINO" Binding="{Binding HorarioTermino, StringFormat=\{0:hh\\:mm\}}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
