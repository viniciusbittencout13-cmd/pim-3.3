<UserControl x:Class="GLLRV.DesktopApp.Views.Pages.Relatorios.RelatorioAvaliacaoTecnicosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Tag="AVALIAÇÃO DOS TÉCNICOS">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="VOCÊ ESTÁ EM  AVALIAÇÃO DOS TÉCNICOS" FontSize="20" FontWeight="SemiBold" Margin="8,0,8,12"/>

        <Grid Grid.Row="1" Margin="8,0,8,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="DE" FontSize="12"/>
                <DatePicker x:Name="DeDate"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="ATÉ" FontSize="12"/>
                <DatePicker x:Name="AteDate"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="PERÍODOS DO DIA" FontSize="12"/>
                <ComboBox x:Name="PeriodoCombo"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="CATEGORIA CHAMADO" FontSize="12"/>
                <ComboBox x:Name="CategoriaCombo"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="NÍVEL DE PRIORIDADE" FontSize="12"/>
                <ComboBox x:Name="PrioridadeCombo"/>
            </StackPanel>
            <StackPanel Grid.Column="5">
                <TextBlock Text="TÉCNICO RESPONSÁVEL" FontSize="12"/>
                <ComboBox x:Name="TecnicoCombo"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#10FFFFFF" CornerRadius="8" Padding="12">
            <TextBlock Text="Gráfico (placeholder)" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666"/>
        </Border>

        <Grid Grid.Row="3" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Button Content="VOLTAR" Width="120" Height="36" Click="Voltar_Click"/>
            <Button Grid.Column="1" Content="EXPORTAR RELATÓRIO" Width="200" Height="36" Margin="8,0"/>
            <Button Grid.Column="2" Content="EXPORTAR" Height="36"/>
        </Grid>
    </Grid>
</UserControl>
