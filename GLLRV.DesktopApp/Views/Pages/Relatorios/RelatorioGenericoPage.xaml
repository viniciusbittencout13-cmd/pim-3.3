<UserControl x:Class="GLLRV.DesktopApp.Views.Pages.Relatorios.RelatorioGenericoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Título -->
            <RowDefinition Height="Auto"/>
            <!-- Filtros -->
            <RowDefinition Height="Auto"/>
            <!-- Área do gráfico -->
            <RowDefinition Height="*"/>
            <!-- Botões -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO DO RELATÓRIO (o code-behind altera esse texto) -->
        <TextBlock x:Name="PageTitleText"
                   Text="RELATÓRIO"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <!-- LINHA DE FILTROS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>   <!-- De -->
                <ColumnDefinition Width="2*"/>   <!-- Até -->
                <ColumnDefinition Width="2*"/>   <!-- Períodos do dia -->
                <ColumnDefinition Width="2*"/>   <!-- Categoria chamado -->
                <ColumnDefinition Width="2*"/>   <!-- Nível prioridade -->
                <ColumnDefinition Width="2*"/>   <!-- Técnico resp. -->
            </Grid.ColumnDefinitions>

            <!-- DE -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="DE"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <DatePicker/>
            </StackPanel>

            <!-- ATÉ -->
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="ATÉ"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <DatePicker/>
            </StackPanel>

            <!-- PERÍODOS DO DIA -->
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="PERÍODOS DO DIA"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ComboBox>
                    <ComboBoxItem Content="Manhã"/>
                    <ComboBoxItem Content="Tarde"/>
                    <ComboBoxItem Content="Noite"/>
                </ComboBox>
            </StackPanel>

            <!-- CATEGORIA CHAMADO -->
            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                <TextBlock Text="CATEGORIA CHAMADO"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ComboBox>
                    <ComboBoxItem Content="Servidores"/>
                    <ComboBoxItem Content="Rede"/>
                    <ComboBoxItem Content="Usuários"/>
                </ComboBox>
            </StackPanel>

            <!-- NÍVEL DE PRIORIDADE -->
            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                <TextBlock Text="NÍVEL DE PRIORIDADE"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ComboBox>
                    <ComboBoxItem Content="Baixa"/>
                    <ComboBoxItem Content="Média"/>
                    <ComboBoxItem Content="Alta"/>
                </ComboBox>
            </StackPanel>

            <!-- TÉCNICO RESPONSÁVEL -->
            <StackPanel Grid.Column="5">
                <TextBlock Text="TÉCNICO RESPONSÁVEL"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ComboBox>
                    <ComboBoxItem Content="Vinicius"/>
                    <ComboBoxItem Content="Gustavo"/>
                    <ComboBoxItem Content="Ralyson"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ÁREA DO GRÁFICO (apenas placeholder visual) -->
        <Border Grid.Row="2"
                CornerRadius="12"
                Background="#20FFFFFF"
                BorderBrush="#33000000"
                BorderThickness="1"
                Padding="8">
            <TextBlock Text="Área reservada para o gráfico"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Foreground="#666666"/>
        </Border>

        <!-- BOTÕES RODAPÉ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Voltar"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="VoltarButton_Click"/>
            <Button Content="Exportar Relatório"
                    Width="160"/>
        </StackPanel>
    </Grid>
</UserControl>
