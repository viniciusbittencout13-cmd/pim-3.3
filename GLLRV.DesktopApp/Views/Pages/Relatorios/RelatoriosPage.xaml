<UserControl x:Class="GLLRV.DesktopApp.Views.Pages.Relatorios.RelatoriosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Tag="RELATÓRIOS">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título interno da página (opcional, o header lá em cima usa o Tag) -->
        <TextBlock Text="RELATÓRIOS"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <!-- Cartão central com os 4 tipos de relatório -->
        <Border Grid.Row="1"
                Background="#80FFFFFF"
                CornerRadius="16"
                Padding="40">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="400">

                <Button Content="TEMPO MÉDIO DE ATENDIMENTO"
                        Height="40"
                        Margin="0,0,0,12"
                        Click="TempoAtendimento_Click"/>

                <Button Content="AVALIAÇÃO DOS ATENDIMENTOS"
                        Height="40"
                        Margin="0,0,0,12"
                        Click="AvaliacaoAtendimento_Click"/>

                <Button Content="AVALIAÇÃO DOS TÉCNICOS"
                        Height="40"
                        Margin="0,0,0,12"
                        Click="AvaliacaoTecnicos_Click"/>

                <Button Content="ATENDIMENTOS"
                        Height="40"
                        Margin="0,0,0,0"
                        Click="Atendimentos_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
