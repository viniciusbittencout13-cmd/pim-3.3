<UserControl x:Class="GLLRV.DesktopApp.Views.Pages.Usuarios.CadastroTecnicoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Tag="CADASTRO TÉCNICO">

    <Grid Margin="40,24,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título da página -->
        <TextBlock Grid.Row="0"
                   Text="CADASTRO TÉCNICO"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Cartão central -->
        <Border Grid.Row="1"
                Background="#CCFFFFFF"
                CornerRadius="24"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="680">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Nome / Telefone -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>  <!-- CPF / Nível -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>  <!-- Nome usuário / Senha -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>  <!-- Email / Categoria -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>  <!-- Botões -->
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- NOME E SOBRENOME / TELEFONE -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="NOME E SOBRENOME"
                           Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="TELEFONE"
                           Margin="10,0,0,4"/>

                <TextBox x:Name="NomeTextBox"
                         Grid.Row="1" Grid.Column="0"
                         Margin="0,0,10,10"
                         Height="30"/>

                <TextBox x:Name="TelefoneTextBox"
                         Grid.Row="1" Grid.Column="1"
                         Margin="10,0,0,10"
                         Height="30"/>

                <!-- CPF / NÍVEL TÉCNICO -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="CPF"
                           Margin="0,8,0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="NÍVEL DO TÉCNICO"
                           Margin="10,8,0,4"/>

                <TextBox x:Name="CpfTextBox"
                         Grid.Row="3" Grid.Column="0"
                         Margin="0,0,10,10"
                         Height="30"/>

                <ComboBox x:Name="NivelComboBox"
                          Grid.Row="3" Grid.Column="1"
                          Margin="10,0,0,10"
                          Height="30">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                </ComboBox>

                <!-- NOME DE USUÁRIO / SENHA PRIMEIRO ACESSO -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="NOME DE USUÁRIO"
                           Margin="0,8,0,4"/>
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="SENHA DE PRIMEIRO ACESSO"
                           Margin="10,8,0,4"/>

                <!-- AQUI TEMOS APENAS UM NomeUsuarioTextBox -->
                <TextBox x:Name="NomeUsuarioTextBox"
                         Grid.Row="5" Grid.Column="0"
                         Margin="0,0,10,10"
                         Height="30"/>

                <PasswordBox x:Name="SenhaPasswordBox"
                             Grid.Row="5" Grid.Column="1"
                             Margin="10,0,0,10"
                             Height="30"/>

                <!-- EMAIL / CATEGORIA -->
                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="EMAIL"
                           Margin="0,8,0,4"/>
                <TextBlock Grid.Row="6" Grid.Column="1"
                           Text="CATEGORIA (TIPOS DE CHAMADOS)"
                           Margin="10,8,0,4"/>

                <TextBox x:Name="EmailTextBox"
                         Grid.Row="7" Grid.Column="0"
                         Margin="0,0,10,10"
                         Height="30"/>

                <TextBox x:Name="CategoriaTextBox"
                         Grid.Row="7" Grid.Column="1"
                         Margin="10,0,0,10"
                         Height="30"/>

                <!-- Botões -->
                <StackPanel Grid.Row="8" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,30,0,0">
                    <Button Content="CANCELAR"
                            Width="120"
                            Margin="0,0,12,0"
                            Click="CancelarButton_Click"/>
                    <Button Content="CADASTRAR"
                            Width="140"
                            Click="CadastrarButton_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
