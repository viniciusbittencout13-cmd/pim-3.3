<UserControl x:Class="GLLRV.DesktopApp.Views.Pages.Usuarios.EditarTecnicoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Tag="EDITAR TÉCNICO">
    <Grid Margin="40,24,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="EDITAR TÉCNICO"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="#CCFFFFFF"
                CornerRadius="24"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="680">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- label busca -->
                    <RowDefinition Height="Auto"/>  <!-- cpf + botão -->
                    <RowDefinition Height="10"/>    <!-- espaço -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- BUSCA POR CPF -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="DIGITE O CPF DO USUÁRIO QUE DESEJA EDITAR"
                           Margin="0,0,0,4"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                    <TextBox x:Name="BuscaCpfTextBox"
                             Width="220"
                             Height="28"
                             Margin="0,0,8,0"/>
                    <Button Content="CARREGAR DADOS"
                            Width="150"
                            Height="28"
                            Click="CarregarButton_Click"/>
                </StackPanel>

                <!-- NOME / TELEFONE -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="NOME E SOBRENOME" Margin="0,8,0,4"/>
                <TextBox x:Name="NomeTextBox"
                         Grid.Row="4" Grid.Column="0" Margin="0,0,10,10" Height="30"/>

                <TextBlock Grid.Row="3" Grid.Column="1" Text="TELEFONE" Margin="10,8,0,4"/>
                <TextBox x:Name="TelefoneTextBox"
                         Grid.Row="4" Grid.Column="1" Margin="10,0,0,10" Height="30"/>

                <!-- CPF (fixo para mostrar/ajustar se quiser) -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="CPF" Margin="0,8,0,4"/>
                <TextBox x:Name="CpfTextBox"
                         Grid.Row="6" Grid.Column="0" Margin="0,0,10,10" Height="30"/>

                <!-- NÍVEL TÉCNICO -->
                <TextBlock Grid.Row="5" Grid.Column="1" Text="NÍVEL TÉCNICO" Margin="10,8,0,4"/>
                <ComboBox x:Name="NivelComboBox"
                          Grid.Row="6" Grid.Column="1" Margin="10,0,0,10" Height="30">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                </ComboBox>

                <!-- NOME DE USUÁRIO -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="NOME DE USUÁRIO" Margin="0,8,0,4"/>
                <TextBox x:Name="NomeUsuarioTextBox"
                         Grid.Row="8" Grid.Column="0" Margin="0,0,10,10" Height="30"/>

                <!-- SENHA PRIMEIRO ACESSO -->
                <TextBlock Grid.Row="7" Grid.Column="1" Text="SENHA DE PRIMEIRO ACESSO" Margin="10,8,0,4"/>
                <PasswordBox x:Name="SenhaPasswordBox"
                             Grid.Row="8" Grid.Column="1" Margin="10,0,0,10" Height="30"/>

                <!-- EMAIL -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="EMAIL" Margin="0,8,0,4"/>
                <TextBox x:Name="EmailTextBox"
                         Grid.Row="10" Grid.Column="0" Margin="0,0,10,10" Height="30"/>

                <!-- CATEGORIA / TIPO DE CHAMADOS -->
                <TextBlock Grid.Row="9" Grid.Column="1" Text="CATEGORIA (TIPO DE CHAMADOS)" Margin="10,8,0,4"/>
                <TextBox x:Name="CategoriaTextBox"
                         Grid.Row="10" Grid.Column="1" Margin="10,0,0,10" Height="30"/>

                <!-- Botões -->
                <StackPanel Grid.Row="10" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,50,0,0">
                    <Button Content="CANCELAR"
                            Width="120"
                            Margin="0,0,12,0"
                            Click="CancelarButton_Click"/>
                    <Button Content="SALVAR"
                            Width="140"
                            Click="SalvarButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
